# Copy to .env and fill in your values. Git ignores .env.
# None of these are secrets: Google access comes from an identity, not a key.
# Locally that identity is yours: gcloud auth application-default login
# On Cloud Run it is the service account that deploy.sh creates.

# Your Google Cloud project.
PROJECT=your-project-id
REGION=europe-west1

# The Cloud Run service, which also names its service account.
SERVICE=message-page

# The private bucket the service reads from. The name must be unique across Google Cloud.
BUCKET_NAME=your-unique-bucket-name

# Printed by deploy.sh at the end of the first deploy. Used by the live check.
SERVICE_URL=

# Do not set this. Cloud Run provides K_REVISION, and locally the page shows "local".
# K_REVISION=
